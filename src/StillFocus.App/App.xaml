<Application x:Class="StillFocus.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#202A37"/>
  <SolidColorBrush x:Key="Muted" Color="#9BAABC"/>
  <SolidColorBrush x:Key="Accent" Color="#4A82FF"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="#F1F5FB"/><Setter Property="Background" Value="#17202C"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F1F5FB"/><Setter Property="Background" Value="#303F52"/><Setter Property="BorderBrush" Value="#43516A"/><Setter Property="Padding" Value="17,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#3C5580"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#202C3C"/><Setter Property="Foreground" Value="#F1F5FB"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#4C5D77"/><Setter Property="Padding" Value="9,7"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Margin" Value="0,7,0,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DatePickerTextBox"><Setter Property="Foreground" Value="#F1F5FB"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePickerTextBox"><Border Background="#202C3C" Padding="5"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#1B2532"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,12"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#285EDB"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="B" Property="Background" Value="#2E3E54"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#202A37"/><Setter Property="Foreground" Value="#EEF3FA"/><Setter Property="BorderBrush" Value="#44536B"/><Setter Property="Padding" Value="5"/><Setter Property="HasDropShadow" Value="True"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Padding" Value="10,7"/></Style>
  <Style TargetType="Separator"><Setter Property="Background" Value="#405069"/><Setter Property="Margin" Value="5,4"/></Style>
 </Application.Resources>
</Application>
