<Window x:Class="StillFocus.App.EventsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="倒数日管理 · 静时" Style="{StaticResource {x:Type Window}}" Width="610" Height="455" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="Assets/app.ico">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="值得期待的日子" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="管理重要日期，轻点卡片顶部即可切换。" Foreground="{StaticResource Muted}" Margin="0,7,0,20"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox x:Name="EventList" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="125"/><TextBlock Text="{Binding Date,StringFormat=yyyy-MM-dd}" FontSize="11" Opacity=".7" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <StackPanel Grid.Column="1" Margin="22,0,0,0"><TextBlock Text="事件名称" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/><TextBox x:Name="NameBox" MaxLength="100" AutomationProperties.Name="事件名称"/>
    <TextBlock Text="目标日期" Foreground="{StaticResource Muted}" Margin="0,17,0,7"/><DatePicker x:Name="DateBox" SelectedDateFormat="Short" Background="#253246" Foreground="#F1F5FB" Language="zh-CN" Padding="6" AutomationProperties.Name="目标日期"/>
    <CheckBox x:Name="EnabledCheck" Content="启用此事件" Margin="0,15,0,5"/><CheckBox x:Name="SelectedCheck" Content="设为当前显示事件"/>
    <TextBlock x:Name="ErrorText" Foreground="#FFB2A6" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0"><Button Content="＋ 添加" Click="AddClick"/><Button Content="应用编辑" Click="ApplyClick"/><Button Content="删除" Click="DeleteClick"/></StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="取消" IsCancel="True"/><Button Content="保存全部" Click="SaveClick" Background="#2867EB" BorderBrush="#4A82FF" Margin="0"/></StackPanel>
 </Grid>
</Window>
